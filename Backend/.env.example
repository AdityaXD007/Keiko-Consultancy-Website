# ==============================================================================
# Backend Environment Configuration Template for Railway
# Copy these key-value pairs into Railway Dashboard -> Variables tab
# ==============================================================================

# Django Secret Key (Production Secret Key)
SECRET_KEY=ypjn3tnzfCh4JqRKB09-jq9BiefV88TPJu5pQb8CELC1Ji1_ZTDBd2ZkHnwa3NiQc_U

# Debug Mode (STRICTLY False in production)
DEBUG=False


# Database URL (Injected automatically by Railway Postgres plugin; no manual entry needed if attached)
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Allowed Hosts (comma-separated list of custom domains and Railway public domain)
ALLOWED_HOSTS=yokohama.edu.np,www.yokohama.edu.np,.up.railway.app

# CSRF Trusted Origins (comma-separated list with https:// scheme)
CSRF_TRUSTED_ORIGINS=https://yokohama.edu.np,https://www.yokohama.edu.np

# CORS Allowed Origins (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=https://yokohama.edu.np,https://www.yokohama.edu.np,http://localhost:3000

# SSL Settings (Set to True in production with custom domain HTTPS)
SECURE_SSL_REDIRECT=True

# Cloudinary Storage Configuration (for media file hosting in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

